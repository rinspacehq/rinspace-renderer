# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867

FROM scratch AS texlive-archives
ARG RENDERER_SOURCE_ROOT=.
ARG TEXLIVE_ARCHIVE=https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/2022/tlnet-final/archive
ADD --checksum=sha256:66d4aa657d0fbf7bdacfc980ea6d0ecb8c19e535ea2fa6b90f6f9e4ae0b4cb75 ${TEXLIVE_ARCHIVE}/courierten.tar.xz /archives/courierten.tar.xz
ADD --checksum=sha256:d5fba52d7987aa6add318649fc050067328179278d7cab644f750bf255c79eb3 ${TEXLIVE_ARCHIVE}/libertine.tar.xz /archives/libertine.tar.xz
ADD --checksum=sha256:402084ba84ae4f1b86dee6fc44042e0643e097f95fd5cd514966819a962915f1 ${TEXLIVE_ARCHIVE}/algorithm2e.tar.xz /archives/algorithm2e.tar.xz
ADD --checksum=sha256:60fe27edf2325cecc1e9b7e4d36f03cdc9c3c5c441a4c839497ca29f3e857071 ${TEXLIVE_ARCHIVE}/boondox.tar.xz /archives/boondox.tar.xz
ADD --checksum=sha256:afb5ba969340b1808f23a111a3cf6614480a1f52a2b589448c86ec064b3ff71b ${TEXLIVE_ARCHIVE}/adforn.tar.xz /archives/adforn.tar.xz
ADD --checksum=sha256:503fcc29c691b588171a777ef911ba3aedeae888a662d3c68bcb8c450bdaf7e8 ${TEXLIVE_ARCHIVE}/adforn.doc.tar.xz /archives/adforn.doc.tar.xz
ADD --checksum=sha256:8cc820e97a91190679cdc963dc162b28955c367d57f406bc96d82e1e2821efa2 ${TEXLIVE_ARCHIVE}/bbding.tar.xz /archives/bbding.tar.xz
ADD --checksum=sha256:261491ad37eee46476c6a3629c7163127fe279fe3cb0621609fece7109a0d3af ${TEXLIVE_ARCHIVE}/bbding.doc.tar.xz /archives/bbding.doc.tar.xz
ADD --checksum=sha256:e4dd76ffb0afa4ba25dea2e4fd3244ed33b62f84498d83a8ef83a994a73d8bc5 ${TEXLIVE_ARCHIVE}/cmupint.tar.xz /archives/cmupint.tar.xz
ADD --checksum=sha256:ef2b807a64fcf1d237fda466072507ba3565a66126f5b892a3e5aaa11c46c000 ${TEXLIVE_ARCHIVE}/cmupint.doc.tar.xz /archives/cmupint.doc.tar.xz
ADD --checksum=sha256:7f3b49c11014db349728fb8c0e411955dd745872222686e0b46851069bcfecef ${TEXLIVE_ARCHIVE}/extarrows.tar.xz /archives/extarrows.tar.xz
ADD --checksum=sha256:a10e92523123b7eafd86d02db6447c7fa5542a0df5e582565a9c6d63a102a4e2 ${TEXLIVE_ARCHIVE}/extarrows.doc.tar.xz /archives/extarrows.doc.tar.xz
ADD --checksum=sha256:50bfa3e5182ce32281cef269dbb8d4d2b727899391df1ef6c1ca1be2108e215e ${TEXLIVE_ARCHIVE}/newtx.tar.xz /archives/newtx.tar.xz
ADD --checksum=sha256:7930c91eba52d057f133245d43255f1fe331d2b6d84c149cea3d824d85b8efd2 ${TEXLIVE_ARCHIVE}/newtx.doc.tar.xz /archives/newtx.doc.tar.xz
ADD --checksum=sha256:5d2e75dba828d677311b9eda17dc678b61c63a27bae0babf1169461b41fe9f98 ${TEXLIVE_ARCHIVE}/physics.tar.xz /archives/physics.tar.xz
ADD --checksum=sha256:6fc01e5e4efd11dbf08db1df4a79e7961e9a863a2460382b3bb048771d777239 ${TEXLIVE_ARCHIVE}/physics.doc.tar.xz /archives/physics.doc.tar.xz
ADD --checksum=sha256:5b268a4ee7a7a2ae8d04a04e5f7a6228d76e2eddaf735254f671e8bb00baca9e ${TEXLIVE_ARCHIVE}/soul.tar.xz /archives/soul.tar.xz
ADD --checksum=sha256:e97efb44a060751b381dcff8adbfa0e72086cf06255d7acc56f74ae5c5c7ea1b ${TEXLIVE_ARCHIVE}/soul.doc.tar.xz /archives/soul.doc.tar.xz
ADD --checksum=sha256:66eee0362a9db0408d5fb436ba7e8bd57e0e87441eeb9f8ec0166fbb4aa5be6d https://deb.debian.org/debian/pool/main/t/texlive-extra/texlive-bibtex-extra_2022.20230122-4_all.deb /archives/texlive-bibtex-extra.deb
ADD --checksum=sha256:a4c99199033bd8c288a7adf69e22db073ad118253bf1eaf883215f8400a2805a ${TEXLIVE_ARCHIVE}/courierten.doc.tar.xz /archives/courierten.doc.tar.xz
ADD --checksum=sha256:24a694cafb9b37b7164844473b07f7bd3bffeb2b3fea11afee82f4ab02a86d9c ${TEXLIVE_ARCHIVE}/libertine.doc.tar.xz /archives/libertine.doc.tar.xz
ADD --checksum=sha256:6ac0c3f222167dcb7e701a9168b077e5abc6c705301bb9d0e2d96060f436a759 ${TEXLIVE_ARCHIVE}/algorithm2e.doc.tar.xz /archives/algorithm2e.doc.tar.xz
ADD --checksum=sha256:b62bd8cbf4bb2c1b7f4c507fa37002f0d3b60de5b84f93a52155abd9e709f524 ${TEXLIVE_ARCHIVE}/boondox.doc.tar.xz /archives/boondox.doc.tar.xz
ADD --checksum=sha256:ba485390a8e857c6baf37aa3b1d9c6fe7c0782a1fdc1791b9e41938da97ceba7 ${TEXLIVE_ARCHIVE}/stix.doc.tar.xz /archives/stix.doc.tar.xz
ADD --checksum=sha256:c1ae6e179a6d28bbd5c483fbacc744acc75e922d598281dc3390aab26126e163 https://www.latex-project.org/lppl/lppl-1-3c.txt /archives/LICENSE.LPPL-1.3c
ADD --checksum=sha256:1d361a8f8e8ce6e68457dcd93fb56e162e6baa3bbb7e7573a290d44399f6b57e https://openfontlicense.org/documents/OFL.txt /archives/LICENSE.OFL-1.1

FROM --platform=linux/amd64 ${BASE_IMAGE}
ARG RENDERER_SOURCE_ROOT=.

ARG SOURCE_HASH=unresolved
LABEL com.rinspace.latex-pdf.source-sha256="${SOURCE_HASH}"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SOURCE_DATE_EPOCH=0 \
    FORCE_SOURCE_DATE=1 \
    HOME=/tmp/rinspace-home \
    TEXMFHOME=/tmp/rinspace-texmf-home \
    TEXMFVAR=/tmp/rinspace-texmf-var \
    TEXMFCONFIG=/tmp/rinspace-texmf-config \
    TEXMFOUTPUT=/output \
    openin_any=p \
    openout_any=p \
    shell_escape=f

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      biber=2.18-1 \
      ca-certificates=20250419~deb12u2 \
      fonts-lmodern=2.005-1 \
      fonts-noto-cjk=1:20220127+repack1-1 \
      fonts-texgyre=20180621-6 \
      ghostscript=10.0.0~dfsg-11+deb12u9 \
      latexmk=1:4.79-1 \
      texlive-base=2022.20230122-3 \
      texlive-binaries=2022.20220321.62855-5.1+deb12u2 \
      texlive-fonts-recommended=2022.20230122-3 \
      texlive-lang-chinese=2022.20230122-1 \
      texlive-latex-base=2022.20230122-3 \
      texlive-latex-extra=2022.20230122-4 \
      texlive-latex-recommended=2022.20230122-3 \
      texlive-luatex=2022.20230122-3 \
      texlive-pictures=2022.20230122-3 \
      texlive-xetex=2022.20230122-3 \
      xz-utils=5.4.1-1+deb12u2 \
    && rm -f /usr/bin/tlmgr \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /root/.cache

COPY ${RENDERER_SOURCE_ROOT}/deploy/texmf-rinspace.cnf /etc/texmf/web2c/texmf.cnf.d/99-rinspace.cnf
COPY ${RENDERER_SOURCE_ROOT}/deploy/latex-pdf.lock.json /opt/rinspace/latex-pdf.lock.json
COPY ${RENDERER_SOURCE_ROOT}/deploy/latex-font-aliases/ /usr/local/share/texmf/tex/latex/rinspace-font-aliases/
COPY --chmod=0755 ${RENDERER_SOURCE_ROOT}/deploy/rinspace-latex-compile /usr/local/bin/rinspace-latex-compile
COPY --chmod=0755 ${RENDERER_SOURCE_ROOT}/deploy/verify-latex-pdf-runtime.sh /usr/local/bin/verify-latex-pdf-runtime

RUN --network=none --mount=type=bind,from=texlive-archives,source=/archives,target=/archives,readonly \
    set -eu; \
    notices=/usr/share/doc/rinspace-texlive-extra; \
    mkdir -p /usr/local/share/texmf "$notices"; \
    for package in courierten libertine algorithm2e boondox; do \
      tar -xJf "/archives/$package.tar.xz" -C /usr/local/share/texmf --exclude='tlpkg/*'; \
      case "$package" in algorithm2e) docs=latex ;; *) docs=fonts ;; esac; \
      tar -xOJf "/archives/$package.doc.tar.xz" "doc/$docs/$package/README" > "$notices/NOTICE.$package"; \
    done; \
    tar -xOJf /archives/courierten.doc.tar.xz doc/fonts/courierten/COPYING > "$notices/COPYING.courierten"; \
    tar -xOJf /archives/libertine.doc.tar.xz doc/fonts/libertine/LICENCE.txt > "$notices/NOTICE.libertine-license"; \
    tar -xOJf /archives/libertine.doc.tar.xz doc/fonts/libertine/GPL.txt > "$notices/LICENSE.libertine-GPL-with-font-exception"; \
    tar -xOJf /archives/stix.doc.tar.xz doc/fonts/stix/STIX_Font_License_2010.txt > "$notices/LICENSE.boondox-STIX"; \
    for package in adforn bbding cmupint extarrows physics soul; do \
      tar -xJf "/archives/$package.tar.xz" -C /usr/local/share/texmf --exclude='tlpkg/*'; \
    done; \
    tar -xJf /archives/newtx.tar.xz -C /usr/local/share/texmf \
      fonts/opentype/public/newtx/TeXGyreTermesX-Regular.otf \
      fonts/opentype/public/newtx/TeXGyreTermesX-Italic.otf \
      fonts/opentype/public/newtx/TeXGyreTermesX-Bold.otf \
      fonts/opentype/public/newtx/TeXGyreTermesX-BoldItalic.otf; \
    deb="$(mktemp -d)"; \
    dpkg-deb --fsys-tarfile /archives/texlive-bibtex-extra.deb | tar -x -C "$deb" \
      ./usr/share/texlive/texmf-dist/tex/latex/biblatex \
      ./usr/share/texlive/texmf-dist/tex/latex/logreq \
      ./usr/share/doc/texlive-bibtex-extra/copyright \
      ./usr/share/doc/texlive-doc/latex/biblatex/README.gz \
      ./usr/share/doc/texlive-doc/latex/logreq/README; \
    gzip -cd "$deb/usr/share/doc/texlive-doc/latex/biblatex/README.gz" > "$notices/NOTICE.biblatex"; \
    install -m 0644 "$deb/usr/share/doc/texlive-doc/latex/logreq/README" "$notices/NOTICE.logreq"; \
    cp -a "$deb/usr/share/texlive/texmf-dist/tex/latex/biblatex" "$deb/usr/share/texlive/texmf-dist/tex/latex/logreq" /usr/local/share/texmf/tex/latex/; \
    install -m 0644 "$deb/usr/share/doc/texlive-bibtex-extra/copyright" "$notices/NOTICE.bibliography-debian"; \
    rm -rf "$deb"; \
    tar -xOJf /archives/adforn.doc.tar.xz doc/fonts/adforn/COPYING > "$notices/NOTICE.adforn"; \
    tar -xOJf /archives/adforn.doc.tar.xz doc/fonts/adforn/README > "$notices/NOTICE.adforn-README"; \
    tar -xOJf /archives/bbding.doc.tar.xz doc/latex/bbding/README > "$notices/NOTICE.bbding"; \
    tar -xOJf /archives/cmupint.doc.tar.xz doc/fonts/cmupint/README.md > "$notices/NOTICE.cmupint"; \
    tar -xOJf /archives/extarrows.doc.tar.xz doc/latex/extarrows/README.md > "$notices/NOTICE.extarrows"; \
    tar -xOJf /archives/newtx.doc.tar.xz doc/fonts/newtx/README > "$notices/NOTICE.newtx"; \
    tar -xOJf /archives/physics.doc.tar.xz doc/latex/physics/README > "$notices/NOTICE.physics"; \
    tar -xOJf /archives/soul.doc.tar.xz doc/generic/soul/README.md > "$notices/NOTICE.soul"; \
    install -m 0644 /archives/LICENSE.* "$notices/"; \
    mkdir -p /workspace /output \
    && chown 65532:65532 /workspace /output \
    && mktexlsr \
    && updmap-sys --enable Map=CourierOneZeroPitch.map --enable Map=libertine.map --enable Map=boondox.map --enable Map=OrnementsADF.map --enable Map=cmupint.map

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/rinspace-latex-compile"]
