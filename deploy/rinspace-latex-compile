#!/bin/sh
set -eu

fail() {
  printf '%s\n' "rinspace-latex-compile: $*" >&2
  exit 64
}

[ "$#" -eq 1 ] || fail "exactly one relative LaTeX entrypoint is required"
entrypoint="$1"
case "$entrypoint" in
  ''|/*|-*|*\\*|*..*|*//*|*/.|*.|*~|*.tex/) fail "unsafe entrypoint" ;;
  *.[tT][eE][xX]|*.[lL][tT][xX]) ;;
  *) fail "entrypoint must end in .tex or .ltx" ;;
esac

workspace="$(realpath -e /workspace)" || fail "workspace is unavailable"
output="$(realpath -e /output)" || fail "output is unavailable"
source_file="$(realpath -e "/workspace/$entrypoint")" || fail "entrypoint does not exist"
case "$source_file" in
  "$workspace"/*) ;;
  *) fail "entrypoint escapes /workspace" ;;
esac
[ -f "$source_file" ] || fail "entrypoint is not a regular file"
[ -r "$source_file" ] || fail "entrypoint is not readable"
[ -w "$output" ] || fail "output is not writable"

export HOME=/tmp/rinspace-home
export TEXMFHOME=/tmp/rinspace-texmf-home
export TEXMFVAR=/tmp/rinspace-texmf-var

# Bitmap font generation needs a writable cache even under a read-only workspace.
export VARTEXFONTS="$TEXMFVAR/fonts"
export MT_DEFAULT_DESTROOT="$VARTEXFONTS"
export PKFONTS="$VARTEXFONTS//:"
export TEXMFCONFIG=/tmp/rinspace-texmf-config
export TEXMFOUTPUT="$output"
export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-0}"
export FORCE_SOURCE_DATE=1
export openin_any=p
export openout_any=p
export shell_escape=f
mkdir -p "$HOME" "$TEXMFHOME" "$VARTEXFONTS" "$TEXMFCONFIG"

stem="$(basename "$entrypoint")"
stem="${stem%.*}"
pretex='\PassOptionsToPackage{new-dvipdfmx}{bxpdfver}'

compile() (
  destination="$1"
  prelude="$2"
  shift 2
  export TEXMFOUTPUT="$destination"
  # Nested \include writes an auxiliary file under its source-relative directory.
  find "$workspace" -mindepth 1 -type d -exec sh -eu -c '
    destination="$1"
    workspace="$2"
    shift 2
    for directory do
      mkdir -p -- "$destination/${directory#"$workspace"/}"
    done
  ' sh "$destination" "$workspace" {} + || exit 1
  cd "$workspace" || exit 1
  latexmk \
    -norc \
    -no-shell-escape \
    -pdfxe \
    "-usepretex=$prelude" \
    -interaction=nonstopmode \
    -halt-on-error \
    -file-line-error \
    -recorder \
    -synctex=1 \
    -outdir="$destination" \
    "$@" \
    "$entrypoint"
)

source_matches() {
  grep -rEqs --include='*.[tT][eE][xX]' --include='*.[lL][tT][xX]' "$1" "$workspace"
}

# bxpdfver can select PDF 2.0 without probing the pinned driver via shell escape.
compile_log="$output/compile.log"
status=0
compile "$output" "$pretex" >"$compile_log" 2>&1 || status=$?

# Retry a recognized legacy failure with the same read-only source and sandbox.
recipe=''
if [ "$status" -ne 0 ]; then
  if grep -Fq 'LaTeX Error: Environment tikzcd undefined.' "$compile_log"; then
    recipe='tikz-cd'
  elif math_package="$(awk '/Undefined control sequence\./ && getline {
    if ($0 ~ /\\coloneqq([^[:alpha:]@]|$)/) { print "mathtools"; exit }
    if ($0 ~ /\\mathscr([^[:alpha:]@]|$)/) { print "mathrsfs"; exit }
  }' "$compile_log")" && [ -n "$math_package" ]; then
    recipe="$math_package"
  elif grep -Eq 'LaTeX Error: Environment (definition|example|lemma|proposition|theorem) undefined\.' "$compile_log"; then
    recipe='unnumbered-theorems'
  fi
  # LaTeX's built-in enumerate accepts no label option. A legacy list may
  # surface only after an earlier missing math package has been resolved.
  if [ "$recipe" = 'tikz-cd' ] || [ "$recipe" = 'mathtools' ] || [ "$recipe" = 'mathrsfs' ] ||
    grep -Fq "LaTeX Error: Something's wrong--perhaps a missing \item" "$compile_log"; then
    if ! grep -Eq '/(enumerate|enumitem)\.sty' "$compile_log" &&
      source_matches '\\begin\{enumerate\}\[\([aA1iI]\)\]'; then
      recipe='legacy-enumeration'
    fi
  fi
fi
if [ -n "$recipe" ]; then
  case "$recipe" in
    unnumbered-theorems)
      # Run after the source preamble so its own environments take precedence.
      retry_prelude="$(printf '%s' '\AddToHook{begindocument/before}{\RequirePackage{amsthm}
        {\theoremstyle{definition}
        \ifcsname definition\endcsname\else\newtheorem*{definition}{Definition}\fi
        \ifcsname example\endcsname\else\newtheorem*{example}{Example}\fi
        \theoremstyle{plain}
        \ifcsname lemma\endcsname\else\newtheorem*{lemma}{Lemma}\fi
        \ifcsname proposition\endcsname\else\newtheorem*{proposition}{Proposition}\fi
        \ifcsname theorem\endcsname\else\newtheorem*{theorem}{Theorem}\fi}}' | tr -d '\n')"
      if source_matches '\\begin\{tikzcd\}'; then
        retry_prelude="$retry_prelude"'\AddToHook{begindocument/before}{\RequirePackage{tikz-cd}}'
      fi
      if source_matches 'é' && ! grep -Fq 'newunicodechar.sty' "$compile_log"; then
        # Classic math fonts lack this character in older accented subscripts.
        retry_prelude="$retry_prelude"'\AddToHook{begindocument/before}{\RequirePackage{amsmath,newunicodechar}\newunicodechar{é}{\ifmmode\text{\itshape\char233\relax}\else\char233\relax\fi}}'
      fi
      retry_label='Rinspace legacy format: unnumbered-theorems'
      ;;
    legacy-enumeration|mathrsfs)
      retry_prelude=''
      retry_label='Rinspace legacy package: mathrsfs'
      if [ "$recipe" = 'legacy-enumeration' ]; then
        retry_prelude='\AddToHook{begindocument/before}{\RequirePackage{enumerate}}'
        retry_label='Rinspace legacy format: legacy-enumeration'
      fi
      if source_matches '\\begin\{tikzcd\}'; then
        retry_prelude="$retry_prelude"'\AddToHook{begindocument/before}{\RequirePackage{tikz-cd}}'
      fi
      if source_matches '\\coloneqq([^[:alpha:]@]|$)'; then
        retry_prelude="$retry_prelude"'\AddToHook{begindocument/before}{\ifcsname coloneqq\endcsname\else\RequirePackage{mathtools}\fi}'
      fi
      if [ "$recipe" = 'mathrsfs' ] || source_matches '\\mathscr([^[:alpha:]@]|$)'; then
        retry_prelude="$retry_prelude"'\AddToHook{begindocument/before}{\ifcsname mathscr\endcsname\else\RequirePackage{mathrsfs}\fi}'
      fi
      ;;
    *)
      retry_prelude="\RequirePackage{$recipe}"
      retry_label="Rinspace legacy package: $recipe"
      ;;
  esac
  if { [ "$recipe" = 'unnumbered-theorems' ] || [ "$recipe" = 'legacy-enumeration' ] || [ "$recipe" = 'mathrsfs' ]; } &&
    grep -Eq 'Missing character: .*\(U\+[4-9][0-9A-F]{3}\)' "$compile_log" &&
    ! grep -Fq 'xeCJK.sty' "$compile_log"; then
    retry_prelude="$retry_prelude"'\AddToHook{class/article/after}{\RequirePackage{xeCJK}\setCJKmainfont{Noto Serif CJK SC}}'
  fi
  retry_directory="$(mktemp -d "$output/.compatibility.XXXXXX")"
  trap 'rm -rf -- "$retry_directory"' EXIT
  status=0
  compile "$retry_directory" "$retry_prelude$pretex" \
    "-jobname=$stem" >"$retry_directory/compile.log" 2>&1 || status=$?
  {
    printf '%s\n' "$retry_label"
    cat "$retry_directory/compile.log"
  } >"$compile_log"
  if [ "$status" -eq 0 ]; then
    mv -- "$retry_directory/$stem.pdf" "$output/$stem.pdf"
  fi
  rm -rf -- "$retry_directory"
  trap - EXIT
fi

log_limit=2097152
if [ "$(wc -c < "$compile_log")" -gt "$log_limit" ]; then
  head -c "$log_limit" "$compile_log" > "$output/.compile.log.limited"
  mv "$output/.compile.log.limited" "$compile_log"
fi

[ "$status" -eq 0 ] || exit "$status"

pdf="$output/$stem.pdf"
[ -f "$pdf" ] || fail "compiler completed without the expected PDF"
pdf_bytes="$(wc -c < "$pdf")"
[ "$pdf_bytes" -le 33554432 ] || fail "PDF exceeds 32 MiB"
artifact_bytes="$(find "$output" -xdev -type f -printf '%s\n' | awk '{ total += $1 } END { print total + 0 }')"
[ "$artifact_bytes" -le 50331648 ] || fail "artifacts exceed 48 MiB"
