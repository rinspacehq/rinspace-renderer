# Copy to /etc/rin-renderer/rin-renderer.env and fill production secrets.
RIN_RENDERER_ADDR=:8090
RIN_RENDERER_PUBLIC_BASE_URL=
RIN_RENDERER_SERVICE_TOKEN=replace-with-service-token
# Required for the durable job API. The compose migration service applies additive migrations
# first; API/worker startup then verifies the exact embedded history without changing schema.
RIN_RENDERER_DATABASE_URL=postgres://rin_renderer_service:replace-runtime-password@postgres:5432/rinspace?sslmode=require
RIN_RENDERER_SCHEMA_MODE=require-current
RIN_RENDERER_ARTIFACT_ROOT=/var/lib/rin-renderer/artifacts
RIN_RENDERER_SERVICE_PRINCIPAL=rinspace-service
# Compose/systemd override this shared file with api or worker. Keep all only for legacy rollback.
RIN_RENDERER_RUNTIME_ROLE=all
RIN_RENDERER_COMPLETION_MODE=control-plane
RIN_RENDERER_STORAGE_PROVIDER=cloudbase
RIN_RENDERER_WORKER_ID=rin-renderer-worker-1
RIN_RENDERER_WORKER_CONCURRENCY=1
RIN_RENDERER_PDF_WORKER_CONCURRENCY=1
RIN_RENDERER_TYPST_PDF_WORKER_CONCURRENCY=1
# Cloudreve retirement PDF rollout. Manual and automatic preview remain off
# until their separate canary gates pass.
RINSPACE_CODE_PDF_PREVIEW_ENABLED=false
RINSPACE_CODE_AUTO_PDF_ENABLED=false
# Durable completion dispatcher. The receiver accepts both keyed v2 delivery and the unkeyed
# legacy callback during rotation; switch this key ID only after Control Plane accepts it.
RIN_RENDERER_CONTROL_PLANE_EVENT_URL=http://rin-control-plane:8090/internal/v1/events/renderer
RIN_RENDERER_CONTROL_PLANE_EVENT_HMAC_KEY=replace-with-purpose-specific-32-byte-key
RIN_RENDERER_CONTROL_PLANE_EVENT_HMAC_KEY_ID=renderer-current
RIN_RENDERER_COMPLETION_MAX_ATTEMPTS=10
# Keep unset until historical migration jobs receive separate authorization.
RIN_RENDERER_MIGRATION_TOKEN=
RIN_RENDERER_MIGRATION_PRINCIPAL=rinspace-migration
RIN_RENDERER_DEFAULT_DOCUMENT_ENGINE=latexml
RIN_RENDERER_DEFAULT_DIAGRAM_POLICY=rin
RIN_RENDERER_DEFAULT_MATH_POLICY=server
RIN_RENDERER_FINAL_OUTPUT_MAX_BYTES=33554432
RIN_RENDERER_MATH_PRIMARY_ENGINE=mathjax-chtml
RIN_RENDERER_MATHJAX_NODE_BIN=/usr/bin/node
RIN_RENDERER_MATHJAX_SCRIPT=/opt/rin-renderer/engines/mathjax/render-mathjax.mjs
RIN_RENDERER_MATHJAX_VERSION=4.1.3
RIN_RENDERER_MATHJAX_OUTPUT=chtml
RIN_RENDERER_MATHJAX_FONT_VERSION=mathjax-newcm-4.1.3
# Rollout flag. Keep false for the process-per-batch rollback implementation.
RIN_RENDERER_MATHJAX_WARM_WORKERS=false
RIN_RENDERER_MATHJAX_WARM_WORKER_COUNT=2
RIN_RENDERER_MATHJAX_WARM_MAX_REQUEST_BYTES=33554432
RIN_RENDERER_MATHJAX_WARM_MAX_RESPONSE_BYTES=67108864
RIN_RENDERER_MATHJAX_WARM_MAX_TASKS=500
RIN_RENDERER_MATHJAX_WARM_MAX_RSS_BYTES=536870912
RIN_RENDERER_MATHJAX_WARM_START_TIMEOUT_SECONDS=10
RIN_RENDERER_MATHJAX_WARM_STOP_GRACE_MILLISECONDS=1000
RIN_RENDERER_KATEX_NODE_BIN=/usr/bin/node
RIN_RENDERER_KATEX_SCRIPT=/opt/rin-renderer/engines/katex/render-katex.mjs

RIN_RENDERER_TEXSVG_ENDPOINT=http://rin-renderer-texsvg:8091
RIN_RENDERER_TEXSVG_TOKEN=
RIN_RENDERER_LATEXML_ENDPOINT=
RIN_RENDERER_LATEXML_TOKEN=
RIN_RENDERER_LATEXML_AUTO_FALLBACK_CODES=latexml.unavailable,latexml.timeout

RIN_RENDERER_CLOUDBASE_ENV_ID=
RIN_RENDERER_CLOUDBASE_API_KEY=
RIN_RENDERER_STORAGE_BUCKET=rin-renderer
RIN_RENDERER_STORAGE_BASE_URL=
# Optional reader/CDN origin. Control-plane HEAD/GET/POST continue to use STORAGE_BASE_URL.
RIN_RENDERER_STORAGE_PUBLIC_BASE_URL=
