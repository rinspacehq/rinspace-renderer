{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rinspace.com/schemas/rin-renderer/diagnostic.schema.json",
  "title": "RinRendererDiagnostic",
  "type": "object",
  "required": ["severity", "code", "message"],
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
