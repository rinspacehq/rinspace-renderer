{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rinspace.com/schemas/rin-renderer/rin-document-bundle-v3.schema.json",
  "title": "RinTypstResourceBundleV3",
  "type": "object",
  "required": ["schemaVersion", "projectHash", "bundleHash", "state", "contentKind", "documentEngine", "title", "pages", "workUnits", "assets", "diagnostics", "provenance"],
  "properties": {
    "schemaVersion": { "const": "rin-document-bundle/v3" },
    "projectHash": { "$ref": "document-bundle.schema.json#/$defs/sha256" },
    "bundleHash": { "$ref": "document-bundle.schema.json#/$defs/sha256" },
    "state": { "const": "final" },
    "contentKind": { "const": "typst" },
    "documentEngine": { "const": "typst" },
    "title": { "type": "string" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "document-bundle.schema.json#/$defs/page" } },
    "workUnits": { "type": "array", "maxItems": 0 },
    "assets": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/embeddedImage" } },
    "diagnostics": { "type": "array", "items": { "$ref": "document-bundle.schema.json#/$defs/diagnostic" } },
    "provenance": { "$ref": "document-bundle.schema.json#/$defs/provenance" },
    "knowledgeIndex": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "embeddedImage": {
      "type": "object",
      "required": ["id", "kind", "sha256", "bytes", "mediaType", "projectPath", "bodyBase64"],
      "properties": {
        "id": { "$ref": "document-bundle.schema.json#/$defs/identifier" },
        "kind": { "const": "embedded" },
        "sha256": { "$ref": "document-bundle.schema.json#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "mediaType": { "enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp", "image/gif"] },
        "projectPath": { "$ref": "document-bundle.schema.json#/$defs/canonicalPath" },
        "bodyBase64": { "type": "string", "minLength": 4, "maxLength": 22369624, "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      },
      "additionalProperties": false
    }
  }
}
