{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rinspace.com/schemas/rin-renderer/rin-document-bundle-v1.schema.json",
  "title": "RinDocumentBundleV1",
  "type": "object",
  "required": ["schemaVersion", "projectHash", "state", "contentKind", "documentEngine", "title", "pages", "workUnits", "assets", "diagnostics", "provenance"],
  "properties": {
    "schemaVersion": { "const": "rin-document-bundle/v1" },
    "projectHash": { "$ref": "#/$defs/sha256" },
    "bundleHash": { "$ref": "#/$defs/sha256" },
    "state": { "enum": ["draft", "final"] },
    "contentKind": { "enum": ["latex", "markdown", "typst"] },
    "documentEngine": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "type": "string" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "workUnits": { "type": "array", "items": { "$ref": "#/$defs/workUnit" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "pageIdentifier": { "type": "string", "pattern": "^\\p{L}[\\p{L}\\p{N}\\p{M}._:-]{0,127}$" },
    "workId": { "type": "string", "pattern": "^rw_[a-f0-9]{32}$" },
    "position": {
      "type": "object",
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourceLocation": {
      "type": "object",
      "required": ["path", "start"],
      "properties": {
        "path": { "$ref": "#/$defs/canonicalPath" },
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "tocEntry": {
      "type": "object",
      "required": ["id", "depth", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["id", "sourcePath", "fragment", "fragmentFormat", "toc", "dependencyHashes"],
      "properties": {
        "id": { "$ref": "#/$defs/pageIdentifier" },
        "sourcePath": { "$ref": "#/$defs/canonicalPath" },
        "title": { "type": "string" },
        "fragment": { "type": "string" },
        "fragmentFormat": { "enum": ["html-with-rin-placeholders", "html"] },
        "toc": { "type": "array", "items": { "$ref": "#/$defs/tocEntry" } },
        "dependencyHashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "mathAccessibilityContext": {
      "type": "object",
      "properties": {
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "speechStyle": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "mathUnit": {
      "type": "object",
      "required": ["kind", "id", "source", "display", "macroContextHash"],
      "properties": {
        "kind": { "const": "math" },
        "id": { "$ref": "#/$defs/workId" },
        "source": { "type": "string" },
        "display": { "type": "boolean" },
        "macroContextHash": { "$ref": "#/$defs/sha256" },
        "accessibilityContext": { "$ref": "#/$defs/mathAccessibilityContext" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "diagramLayout": {
      "type": "object",
      "properties": { "alignment": { "enum": ["center", "flushleft", "flushright"] } },
      "additionalProperties": false
    },
    "diagramUnit": {
      "type": "object",
      "required": ["kind", "id", "diagramType", "source"],
      "properties": {
        "kind": { "const": "diagram" },
        "id": { "$ref": "#/$defs/workId" },
        "diagramType": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "type": "string" },
        "options": { "type": "string" },
        "layout": { "$ref": "#/$defs/diagramLayout" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "codeUnit": {
      "type": "object",
      "required": ["kind", "id", "source"],
      "properties": {
        "kind": { "const": "code" },
        "id": { "$ref": "#/$defs/workId" },
        "source": { "type": "string" },
        "language": { "type": "string" },
        "meta": { "type": "string" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "workUnit": {
      "oneOf": [
        { "$ref": "#/$defs/mathUnit" },
        { "$ref": "#/$defs/diagramUnit" },
        { "$ref": "#/$defs/codeUnit" }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["id", "kind", "sha256", "bytes", "mediaType"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["project-file", "generated"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "$ref": "#/$defs/nonEmptyString" },
        "projectPath": { "$ref": "#/$defs/canonicalPath" },
        "artifactKey": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "project-file" } }, "required": ["kind"] },
          "then": { "required": ["projectPath"], "not": { "required": ["artifactKey"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "generated" } }, "required": ["kind"] },
          "then": { "required": ["artifactKey"], "not": { "required": ["projectPath"] } }
        }
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "stage"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "stage": { "$ref": "#/$defs/nonEmptyString" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["adapter", "adapterVersion", "engineVersion", "projectGraphSchemaVersion"],
      "properties": {
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "adapterVersion": { "$ref": "#/$defs/nonEmptyString" },
        "engineVersion": { "$ref": "#/$defs/nonEmptyString" },
        "projectGraphSchemaVersion": { "const": "rin-project-graph/v1" }
      },
      "additionalProperties": false
    }
  }
}
