    },
    {
      "name": "reject_oversized_fragment",
      "fragment": "<p>123456789</p>",
      "maxFragmentBytes": 8,
      "wantCode": "final_output.too_large"
    },
    {
      "name": "reject_missing_required_artifact",
      "fragment": "<img src=\"https://cdn.example/missing.svg\" data-rin-math-object-id=\"diagrams/v1/svg-sha256/bb/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.svg\">",
      "wantCode": "final_output.artifact_missing"
    },
    {
      "name": "reject_unreferenced_required_artifact",
      "fragment": "<p>no artifact</p>",
      "requiredArtifacts": [
        {
          "artifactId": "diagrams/v1/svg-sha256/cc/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.svg",
          "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "bytes": 64,
          "mediaType": "image/svg+xml; charset=utf-8",
          "visibility": "public"
        }
      ],
      "wantCode": "final_output.artifact_unreferenced"
    },
    {
      "name": "reject_missing_client_manifest_asset",
      "fragment": "<img src=\"images/missing.png\" data-rin-asset-path=\"images/missing.png\">",
