    },
    {
      "name": "reject_undeclared_relative_resource",
      "fragment": "<img src=\"images/missing.png\">",
      "wantCode": "final_output.artifact_missing"
    },
    {
      "name": "reject_native_latexml_error",
      "fragment": "<p>before</p><span class=\"ltx_ERROR undefined\">\\\\Needspace</span>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "reject_mathml_error",
      "fragment": "<math><merror><mtext>bad input</mtext></merror></math>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "reject_mathjax_error_element",
      "fragment": "<mjx-container><mjx-merror>bad input</mjx-merror></mjx-container>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "reject_mathjax_error_class",
      "fragment": "<span class=\"rin-math mjx-merror\">bad input</span>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "reject_katex_error",
      "fragment": "<span class=\"katex-error\">bad input</span>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "allow_escaped_error_example",
      "fragment": "<pre><code>&lt;span class=\"ltx_ERROR\"&gt;example&lt;/span&gt;</code></pre>"
    },
    {
      "name": "allow_error_class_prefix",
      "fragment": "<p class=\"ltx_ERROR-example\">documentation</p>"
    },
    {
      "name": "reject_unrendered_math_source",
      "fragment": "<div class=\"rin-math rin-math-fallback\"><code class=\"rin-math-source-fallback\">\\bad{x}</code></div>",
      "wantCode": "final_output.render_error"
    },
    {
      "name": "allow_authored_tex_example",
      "fragment": "<pre><code>\\newtheorem{theorem}{Theorem}</code></pre>"
    }
  ]
