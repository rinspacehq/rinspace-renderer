    },
    {
      "name": "reject_dom_clobbering_name",
      "fragment": "<form name=\"window\"></form>",
      "wantCode": "final_output.dom_clobbering_identifier"
    },
    {
      "name": "reject_duplicate_id",
      "fragment": "<h2 id=\"intro\">A</h2><p id=\"intro\">B</p>",
      "wantCode": "final_output.dom_clobbering_identifier"
    },
    {
      "name": "reject_unsafe_style_attribute",
      "fragment": "<p style=\"background:url(javascript:alert(1))\">bad</p>",
