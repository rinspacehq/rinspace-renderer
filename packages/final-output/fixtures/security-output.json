{
  "schemaVersion": "rin-final-output-fixtures/v1",
  "validatorVersion": "rin-final-output/v1",
  "cases": [
    {
      "name": "safe_mathjax_chtml",
      "fragment": "<style class=\"rin-mathjax-chtml-style\">mjx-container{display:inline-block}</style><span id=\"math-1\" class=\"rin-math\"><mjx-container><mjx-math><mjx-mi>x</mjx-mi></mjx-math></mjx-container></span>"
    },
    {
      "name": "safe_public_artifact",
      "fragment": "<figure><img src=\"https://cdn.example/diagram.svg\" data-rin-diagram-object-id=\"diagrams/v1/svg-sha256/aa/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.svg\"></figure>",
      "requiredArtifacts": [
        {
          "artifactId": "diagrams/v1/svg-sha256/aa/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.svg",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 128,
          "mediaType": "image/svg+xml; charset=utf-8",
          "visibility": "public"
        }
      ]
    },
    {
      "name": "safe_client_owned_asset",
      "fragment": "<img src=\"images/a.png\" data-rin-asset-path=\"images/a.png\">",
      "clientOwnedAssets": [
        "images/a.png"
      ]
    },
    {
      "name": "reject_script",
      "fragment": "<p>before</p><script>alert(1)</script>",
      "wantCode": "final_output.executable_element"
    },
    {
      "name": "reject_event_handler",
      "fragment": "<img src=\"https://cdn.example/a.png\" oNerror=\"alert(1)\">",
      "wantCode": "final_output.event_handler"
    },
    {
      "name": "reject_encoded_javascript_url",
      "fragment": "<a href=\"java&#x73;cript:alert(1)\">bad</a>",
      "wantCode": "final_output.unsafe_url"
