    {
      "name": "reject_data_url",
      "fragment": "<img src=\"data:image/svg+xml,%3Csvg%3E%3C/svg%3E\">",
      "wantCode": "final_output.unsafe_url"
    },
    {
      "name": "reject_renderer_local_file",
      "fragment": "<img src=\"file:///tmp/rin-renderer/output.svg\">",
      "wantCode": "final_output.renderer_local_path"
    },
    {
      "name": "reject_renderer_local_host",
      "fragment": "<img src=\"http://127.0.0.1:8090/output.svg\">",
      "wantCode": "final_output.renderer_local_path"
