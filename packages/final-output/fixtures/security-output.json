    {
      "name": "reject_reserved_element",
      "fragment": "<rin-work data-id=\"rw_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"></rin-work>",
      "wantCode": "final_output.unknown_placeholder"
    },
    {
      "name": "reject_reserved_text_token",
